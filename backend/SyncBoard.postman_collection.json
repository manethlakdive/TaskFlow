{
  "info": {
    "name": "SyncBoard API",
    "description": "Working REST APIs (with mock data) for the SyncBoard project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5001" }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amila@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        }
      ]
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "Get Board",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/boards", "host": ["{{baseUrl}}"], "path": ["api", "boards"] }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columnId\": \"todo\",\n  \"title\": \"Write unit tests\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/boards/tasks", "host": ["{{baseUrl}}"], "path": ["api", "boards", "tasks"] }
          }
        },
        {
          "name": "Move Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toColumnId\": \"doing\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/boards/tasks/1/move", "host": ["{{baseUrl}}"], "path": ["api", "boards", "tasks", "1", "move"] }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Get Members",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/members", "host": ["{{baseUrl}}"], "path": ["api", "members"] }
          }
        }
      ]
    },
    {
      "name": "Invites",
      "item": [
        {
          "name": "Send Invite",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kavindu.perera@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invites", "host": ["{{baseUrl}}"], "path": ["api", "invites"] }
          }
        }
      ]
    }
  ]
}
